{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "allow-get-app-status",
    "allow-save-api-key",
    "allow-remove-api-key",
    "allow-select-reference-image",
    "allow-discard-reference",
    "allow-start-generation",
    "allow-cancel-generation",
    "allow-save-output"
  ]
}
